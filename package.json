{
  "name": "recoveryloop-ai",
  "version": "0.0.0",
  "private": true,
  "description": "RecoveryLoop AI — auditable ecommerce exception recovery",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "env:init": "node scripts/init-local-env.mjs",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:down:s1": "tsx scripts/db/down-s1.ts",
    "db:seed:s1": "tsx scripts/db/seed-s1.ts",
    "db:verify:s1": "tsx scripts/db/verify-s1.ts",
    "db:verify:s2": "tsx scripts/db/verify-s2.ts",
    "smoke:all": "tsx scripts/smoke/all.ts",
    "smoke:easypost": "tsx scripts/smoke/easypost.ts",
    "smoke:zai": "tsx scripts/smoke/zai.ts",
    "smoke:paypal": "tsx scripts/smoke/paypal.ts",
    "smoke:paypal:s2:create": "tsx scripts/smoke/paypal-s2-create.ts",
    "smoke:paypal:s2:capture": "tsx scripts/smoke/paypal-s2-capture.ts",
    "smoke:supabase": "tsx scripts/smoke/supabase.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "openai": "7.47.0",
    "postgres": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "globals": "17.13.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
